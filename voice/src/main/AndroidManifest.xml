<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ döljer andra appars tjänster. Utan den här raden ser appen inte Samsungs
         talmotor (com.samsung.SMT) och TextToSpeech får ingen motor alls (etapp 3, ändring 2). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
